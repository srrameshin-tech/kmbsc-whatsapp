    "contact_diary": {
      ".read": false,
      ".write": false,
      "members": {
        ".read": "auth != null && root.child('contact_diary/members').child(auth.uid).child('role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('contact_diary/members').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('email').val() === auth.token.email && ((!root.child('contact_diary/members').exists() && newData.child('role').val() === 'admin' && newData.child('status').val() === 'approved') || (root.child('contact_diary/members').exists() && newData.child('role').val() === 'member' && newData.child('status').val() === 'pending'))) || root.child('contact_diary/members').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'email', 'role', 'status', 'contactsKey'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 60"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "role": {
            ".validate": "newData.val() === 'admin' || newData.val() === 'member'"
          },
          "status": {
            ".validate": "newData.val() === 'approved' || newData.val() === 'pending'"
          },
          "contactsKey": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "user_contacts": {
        "$key": {
          ".read": "auth != null && root.child('contact_diary/members').child(auth.uid).child('contactsKey').val() === $key && root.child('contact_diary/members').child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('contact_diary/members').child(auth.uid).child('contactsKey').val() === $key && root.child('contact_diary/members').child(auth.uid).child('status').val() === 'approved'"
        }
