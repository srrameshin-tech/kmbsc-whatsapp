        ".write": "auth != null && auth.token.email === 'srrameshin@gmail.com'",
        "$id": {
          ".read": true,
          "views": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "confirmations": {
            ".write": true
          }
        }
      }
    },
